# Fire-Operator: Настройки спутниковых API
# Скопируйте этот файл как .env и заполните ключи

# Режим источника данных: offline | online | hybrid
DATA_SOURCE_MODE=offline

# NASA FIRMS — термоточки активного горения (VIIRS)
# Бесплатная регистрация: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_API_KEY=

# Copernicus Data Space Ecosystem — снимки Sentinel-2/1
# Бесплатная регистрация: https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Кэш спутниковых данных
SATELLITE_CACHE_TTL_HOURS=24
SATELLITE_CACHE_MAX_GB=2.0
