# Fire-Operator: Настройки спутниковых API (Активный режим)

# Режим источника данных: online | hybrid | offline
DATA_SOURCE_MODE=hybrid

# NASA FIRMS — термоточки активного горения (VIIRS NRT)
# Регистрация / получение MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_API_KEY=

# Copernicus Data Space Ecosystem — открытый каталог снимков Sentinel-2/1
# https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=sh-0d2c7d50-5809-4dda-beec-5b1bdb61fbfd
CDSE_CLIENT_SECRET=KcLSEMF2ST1ni1eympAfAQrXysVuIBk8

# Кэш спутниковых сцен (0 = кэш отключен, чистый Real-Time)
SATELLITE_CACHE_TTL_HOURS=0
SATELLITE_CACHE_MAX_GB=2.0
